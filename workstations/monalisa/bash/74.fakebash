[autoType, "<span class='grey'>|</span>   User <span class='redBg bold'>jasonbrugger</span> permanently locked.    <span class='grey'>|</span>"]
[autoType:grey, "|                                            |"]
[autoType:grey, "└--------------------------------------------┘"]

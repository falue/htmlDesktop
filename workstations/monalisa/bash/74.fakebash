[autoType:grey, "┌--------------------------------------------┐", 222]
[autoType:grey, "|                                            |"]
[autoType, "<span class='grey'>|</span>   Disabled shell for user <span class='redBg bold'>jasonbrugger</span>.    <span class='grey'>|</span>"]

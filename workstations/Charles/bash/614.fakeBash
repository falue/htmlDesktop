# ------- setup
# bashProfileName - plain text or html
<span class='green'>admin</span>@<span class='red'>localhost</span>:<span class='grey'>~</span> $ 
# -------
[bashProfile] [forceType, "sattrack --begin 5000 -p=33"]
[autoType, "ok", 500]
[bashProfile] [forceType, "python3 ./map-surveillance.py -lat 47.55 -long 7.58 --windowed"]
[br]
[autoType, "Opening service.. ", 500] [spinner:yellow, 1000, 88, "\|/-"]
[br]

[javascript, "parent.addWindow('SURVEILLANCE MAP', 'map', 'map/index.html?scene=614&darkMode=true', 6,6, 1200,800, false)"]

[bashProfile] [waitForEnter]
[clear] [goto:nobr, 0]

EXIT

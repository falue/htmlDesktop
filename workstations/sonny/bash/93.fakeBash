# ------- setup
# bashProfileName - plain text or html
<span class='green'>jbr</span>@<span class='red'>monalisa2</span>:<span class='grey'>~</span> $ 
# -------
# NOTE: If you want to have [ or ] in text, use \[ or \]

# ELCH
[bashProfile] [forceType, "sudo . mona_lisa-auth.sh"]
[autoType, "Run mona_lisa-auth.sh --help for more.", 0]
[br]
[bashProfile] [forceType, ". mona_lisa-master-startup.sh now"]
[autoType:grey, "Startup sequence initiated.", 500]
[br]
[autoType, "Commence graceful shutdown and reboot..", 1500]
[loader, "\[", "▓", "░", "\]", 30, 2000, 0, 100, "", "%"]
[br]
[autoType:blue, "Rebooting now..", 2500]
[sleep, 1000]
[autoType, "Block  0: \[<span class='red bold'>offline</span>\]", 450]
[autoType, "Block  1: \[<span class='red bold'>offline</span>\]", 125]
[autoType, "Block  2: \[<span class='red bold'>offline</span>\]", 250]
[autoType, "Block  3: \[<span class='red bold'>offline</span>\]", 333]
[autoType, "Block  4: \[<span class='red bold'>offline</span>\]", 250]
[autoType, "Block  5: \[<span class='red bold'>offline</span>\]", 666]
[autoType, "Block  6: \[<span class='red bold'>offline</span>\]", 111]
[autoType, "Block  7: \[<span class='red bold'>offline</span>\]", 125]
[autoType, "Block  8: \[<span class='red bold'>offline</span>\]", 250]
[autoType, "Block  9: \[<span class='red bold'>offline</span>\]", 222]
[autoType, "Block 10: \[<span class='red bold'>offline</span>\]", 124]
[autoType, "Block 11: \[<span class='red bold'>offline</span>\]", 100]
[autoType, "Block 12: \[<span class='red bold'>offline</span>\]", 125]
[autoType, "Block 13: \[<span class='red bold'>offline</span>\]", 250]
[autoType, "Block 14: \[<span class='red bold'>offline</span>\]", 333]
[autoType, "Block 15: \[<span class='red bold'>offline</span>\]", 222]
[autoType, "Block 16: \[<span class='red bold'>offline</span>\]", 250]
[autoType, "Block 17: \[<span class='red bold'>offline</span>\]", 200]
[br]
[autoType:grey, "┌---------------------------------┐"]
[autoType:grey, "|                                 |"]
[autoType, "<span class='grey'>|</span> Connection lost. Press any key. <span class='grey'>|</span>"]
[autoType:grey, "|                                 |"]
[autoType:grey, "└---------------------------------┘ "]
[waitForEnter] [clear] [goto:nobr, 0]

# Use EXIT for stop parsing here
EXIT
